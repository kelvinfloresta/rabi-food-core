# Copy to .env.monitoring (gitignored) and fill in from Grafana Cloud: My Account → your stack →
# Loki / Prometheus "Details". The token needs the logs:write and metrics:write scopes.
GRAFANA_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USER_ID=
GRAFANA_PROMETHEUS_URL=https://prometheus-prod-XX-prod-XX.grafana.net/api/prom/push
GRAFANA_PROMETHEUS_INSTANCE_ID=
GRAFANA_TOKEN=
